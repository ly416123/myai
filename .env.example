# Copy to .env and replace both values with local-only credentials.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_DB_USERNAME=myai
AGENT_DB_PASSWORD=replace-with-a-local-database-password
AGENT_DB_URL=jdbc:postgresql://localhost:5432/myai
AGENT_DB_PORT=5432
AGENT_RUN_LEASE_DURATION=30s
AGENT_RUN_LEASE_RENEWAL_INTERVAL=10s

# OTLP exporters remain disabled until a reachable Collector is configured.
AGENT_OTLP_TRACES_ENABLED=false
AGENT_OTLP_METRICS_ENABLED=false
AGENT_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
AGENT_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
